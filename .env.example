# Copy to .env for Docker Compose only. Never add secrets to source control.
BATTERYCHECK_ALLOWED_ORIGINS=http://127.0.0.1:3114,http://localhost:3114
BATTERYCHECK_COOKIE_SECURE=0
# Public deployment requires all three values changed together:
# SITE_ADDRESS=batterycheck.your-domain.example
# BATTERYCHECK_ALLOWED_ORIGINS=https://batterycheck.your-domain.example
# BATTERYCHECK_COOKIE_SECURE=1
# AI 도우미 (선택). 비워 두면 도우미만 비활성화되고 나머지 기능은 동작합니다. 실제 키는 .env에만 두세요.
OPENAI_API_KEY=
# BATTERYCHECK_AI_MODEL=gpt-5.4
# 코디세이 API 콘솔의 OpenAI 호환 키를 쓸 때 (모델 ID는 콘솔 문서의 표를 따릅니다):
# OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# BATTERYCHECK_AI_MODEL=gpt-5.4
# Safety Korea Open API 인증키 (선택). 신청서 승인 후 이메일로 받은 값을 넣습니다. 비워 두면 국내 리콜은 직접 확인 안내만 표시합니다.
# 사진 판독(선택): Anthropic 호환 키가 있으면 AI 이용에 동의한 계정의 사진을 이 경로로 읽습니다.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
# BATTERYCHECK_VISION_MODEL=claude-opus-4-8

SAFETYKOREA_API_KEY=
